+
+fn pairwise_square_sum(input: &[f32]) -> f32 {
+    if input.len() <= 16 {
+        input.iter().map(|v| v * v).sum()
+    } else {
+        let (left, right) = input.split_at(input.len() / 2);
+        pairwise_square_sum(left) + pairwise_square_sum(right)
+    }
+}
