+#[test]
+fn prepared_decode_scales_preserve_outputs_and_account_for_memory() {
+    use uocr::{
+        cpu::{Backend, CpuContext, quantized::Int8Matrix},
+        tensor::Tensor,
+    };
+    for rows in [4, 5, 8] {
+        for cols in [32usize, 33, 1280] {
+            let weights: Vec<i8> = (0..rows * cols).map(|i| (i % 255) as i16 as i8).collect();
+            let scales: Vec<f32> = (0..rows * cols.div_ceil(32))
+                .map(|i| [0., -0., 0.00317, 0.7][i % 4])
+                .collect();
+            let original =
+                Int8Matrix::from_parts(rows, cols, weights.clone(), scales.clone()).unwrap();
+            let mut prepared = Int8Matrix::from_parts(rows, cols, weights, scales).unwrap();
+            let packed = rows % 4 == 0 && cols % 32 == 0;
+            assert_eq!(prepared.prepare_decode_scales().unwrap(), packed);
+            assert_eq!(prepared.prepare_decode_scales().unwrap(), packed);
+            assert_eq!(
+                prepared.storage_bytes(),
+                original.storage_bytes() + if packed { rows * (cols / 32) * 4 } else { 0 }
+            );
+            for backend in [Backend::Scalar, Backend::Auto] {
+                let mut cpu = CpuContext::new(backend, 2, 1 << 20).unwrap();
+                let x = Tensor::new(
+                    vec![1, cols],
+                    (0..cols).map(|i| (i as f32 * 0.17).sin()).collect(),
+                )
+                .unwrap();
+                let expected = original.linear_dynamic_int8(&x, &mut cpu).unwrap();
+                let actual = prepared.linear_dynamic_int8(&x, &mut cpu).unwrap();
+                assert_eq!(
+                    actual.data.iter().map(|v| v.to_bits()).collect::<Vec<_>>(),
+                    expected
+                        .data
+                        .iter()
+                        .map(|v| v.to_bits())
+                        .collect::<Vec<_>>()
+                );
+                assert_eq!(
+                    prepared.dequantize().unwrap().data,
+                    original.dequantize().unwrap().data
+                );
+                let batch = Tensor::new(vec![2, cols], x.data.repeat(2)).unwrap();
+                assert_eq!(
+                    prepared.linear(&batch, &mut cpu).unwrap().data,
+                    original.linear(&batch, &mut cpu).unwrap().data
+                );
+            }
+        }
+    }
