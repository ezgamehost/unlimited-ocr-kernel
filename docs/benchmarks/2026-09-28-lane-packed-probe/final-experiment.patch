+//! Test-only investigation of four-byte-lane-interleaved Q8 weights.
+use super::{
+    lane_q8::{dot_lanes, unpack_lanes},
+    neon,
+};
+
+fn pack(weights: &[i8], scales: &[f32], cols: usize) -> (Vec<i8>, Vec<f32>) {
+    let blocks = cols / 32;
+    assert_eq!(weights.len(), 4 * cols);
+    assert_eq!(scales.len(), 4 * blocks);
+    let mut packed = vec![0; weights.len()];
+    let mut packed_scales = vec![0.; scales.len()];
+    for b in 0..blocks {
+        for row in 0..4 {
+            packed_scales[b * 4 + row] = scales[row * blocks + b];
+            for chunk in 0..8 {
+                for lane in 0..4 {
+                    packed[b * 128 + chunk * 16 + row * 4 + lane] =
+                        weights[row * cols + b * 32 + chunk * 4 + lane];
+                }
+            }
+        }
+    }
+    (packed, packed_scales)
+}
+
+#[test]
+fn lane_packed_dot_and_unpack_match_bits() {
+    if !std::arch::is_aarch64_feature_detected!("dotprod") {
+        return;
+    }
+    for cols in [32usize, 64, 96, 896, 1280, 6848] {
+        let blocks = cols / 32;
+        for offset in 0..4 {
+            let weights: Vec<i8> = (0..4 * cols).map(|i| (i * 71 + i / 17) as i8).collect();
+            let scales: Vec<f32> = (0..4 * blocks)
+                .map(|i| [0., -0., 0.00317, 0.7, 1e-10, 17.][i % 6])
+                .collect();
+            let mut x = vec![0i8; offset];
+            x.extend((0..cols).map(|i| (i * 53 + i / 11) as i8));
+            let xs: Vec<f32> = (0..blocks).map(|i| (i % 17 + 1) as f32 / 123.).collect();
+            let (packed, ps) = pack(&weights, &scales, cols);
+            let mut unaligned = vec![0i8; offset];
+            unaligned.extend(&packed);
+            let mut unaligned_scales = vec![0.; offset];
+            unaligned_scales.extend(&ps);
+            let actual = unsafe {
+                dot_lanes(
+                    &unaligned[offset..],
+                    &x[offset..],
+                    &unaligned_scales[offset..],
+                    &xs,
+                )
+            };
+            let expected =
+                unsafe { neon::dot_int8_four_rows(&weights, &x[offset..], &scales, &xs) };
+            assert_eq!(actual.map(f32::to_bits), expected.map(f32::to_bits));
+            let mut output = vec![f32::NAN; 4 * cols + 2 * offset];
+            unpack_lanes(
+                &unaligned[offset..],
+                &unaligned_scales[offset..],
+                &mut output[offset..offset + 4 * cols],
+                cols,
+            );
+            for i in 0..4 * cols {
+                let expected = weights[i] as f32 * scales[i / cols * blocks + i % cols / 32];
+                assert_eq!(
+                    output[offset + i].to_bits(),
+                    expected.to_bits(),
+                    "cols={cols} offset={offset} i={i}"
+                );
+            }
+            assert!(
+                output[..offset]
+                    .iter()
+                    .chain(&output[offset + 4 * cols..])
+                    .all(|v| v.is_nan())
+            );
+        }
+    }
+}
