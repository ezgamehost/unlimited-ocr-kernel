+#[test]
+#[ignore = "isolated Q8 layout microbenchmark; no full-model speed claim"]
+fn lane_packed_microbenchmark() {
+    use std::{hint::black_box, time::Instant};
+    assert!(std::arch::is_aarch64_feature_detected!("dotprod"));
+    for (rows, cols, repeats) in [
+        (896usize, 1280usize, 128usize),
+        (1280, 896, 128),
+        (1280, 1280, 128),
+        (129280, 1280, 4),
+    ] {
+        let blocks = cols / 32;
+        let weights: Vec<i8> = (0..rows * cols).map(|i| (i * 71 + i / 17) as i8).collect();
+        let scales: Vec<f32> = (0..rows * blocks)
+            .map(|i| (i % 29 + 1) as f32 / 731.)
+            .collect();
+        let x: Vec<i8> = (0..cols).map(|i| (i * 53 + i / 11) as i8).collect();
+        let xs: Vec<f32> = (0..blocks).map(|i| (i % 17 + 1) as f32 / 123.).collect();
+        let mut packed = vec![0i8; weights.len()];
+        let mut packed_scales = vec![0.; scales.len()];
+        let start = Instant::now();
+        for group in 0..rows / 4 {
+            let (w, s) = pack(
+                &weights[group * 4 * cols..(group + 1) * 4 * cols],
+                &scales[group * 4 * blocks..(group + 1) * 4 * blocks],
+                cols,
+            );
+            packed[group * 4 * cols..(group + 1) * 4 * cols].copy_from_slice(&w);
+            packed_scales[group * 4 * blocks..(group + 1) * 4 * blocks].copy_from_slice(&s);
+        }
+        println!(
+            "{}",
+            serde_json::json!({"kind":"packing", "rows":rows,"cols":cols,"seconds":start.elapsed().as_secs_f64()})
+        );
+        let mut output = vec![0.; rows];
+        let mut dequantized = vec![0.; rows * cols];
+        for iteration in 0..7 {
+            for lane in if iteration % 2 == 0 {
+                [false, true]
+            } else {
+                [true, false]
+            } {
+                let start = Instant::now();
+                for _ in 0..repeats {
+                    for (group, out) in output.chunks_exact_mut(4).enumerate() {
+                        let (w, s) = if lane {
+                            (&packed, &packed_scales)
+                        } else {
+                            (&weights, &scales)
+                        };
+                        let w = black_box(&w[group * 4 * cols..(group + 1) * 4 * cols]);
+                        let s = black_box(&s[group * 4 * blocks..(group + 1) * 4 * blocks]);
+                        let result = unsafe {
+                            if lane {
+                                dot_lanes(w, black_box(&x), s, black_box(&xs))
+                            } else {
+                                neon::dot_int8_four_rows(w, black_box(&x), s, black_box(&xs))
+                            }
+                        };
+                        out.copy_from_slice(&result);
+                    }
+                    black_box(&output);
+                }
+                let dot_seconds = start.elapsed().as_secs_f64() / repeats as f64;
+                let checksum: u64 = output.iter().map(|v| u64::from(v.to_bits())).sum();
+                let start = Instant::now();
+                for _ in 0..repeats.min(8) {
+                    if lane {
+                        for (group, out) in dequantized.chunks_exact_mut(4 * cols).enumerate() {
+                            unpack_lanes(
+                                black_box(&packed[group * 4 * cols..(group + 1) * 4 * cols]),
+                                black_box(
+                                    &packed_scales[group * 4 * blocks..(group + 1) * 4 * blocks],
+                                ),
+                                out,
+                                cols,
+                            );
+                        }
+                    } else {
+                        for ((w, s), out) in black_box(&weights)
+                            .chunks_exact(cols)
+                            .zip(black_box(&scales).chunks_exact(blocks))
+                            .zip(dequantized.chunks_exact_mut(cols))
+                        {
+                            for ((w, &scale), out) in
+                                w.chunks_exact(32).zip(s).zip(out.chunks_exact_mut(32))
+                            {
+                                for (dest, &value) in out.iter_mut().zip(w) {
+                                    *dest = value as f32 * scale;
+                                }
+                            }
+                        }
+                    }
+                    black_box(&dequantized);
+                }
+                let unpack_seconds = start.elapsed().as_secs_f64() / repeats.min(8) as f64;
+                let unpack_checksum: u64 = dequantized.iter().map(|v| u64::from(v.to_bits())).sum();
+                println!(
+                    "{}",
+                    serde_json::json!({"kind":"sample","rows":rows,"cols":cols,"lane_packed":lane,"iteration":iteration,"warmup":iteration==0,"dot_seconds":dot_seconds,"unpack_seconds":unpack_seconds,"checksum":checksum,"unpack_checksum":unpack_checksum})
+                );
+            }
+        }
+    }
+}
