+#[cfg(test)]
+mod lane_layout_tests {
+    use super::*;
+
+    #[test]
+    fn packed_q8_preserves_all_paths_and_storage() {
+        for (rows, cols) in [
+            (4usize, 32usize),
+            (8, 96),
+            (12, 896),
+            (4, 1280),
+            (5, 33),
+            (3, 32),
+        ] {
+            let weights: Vec<i8> = (0..rows * cols).map(|i| (i * 71 + i / 17) as i8).collect();
+            let scales: Vec<f32> = (0..rows * cols.div_ceil(32))
+                .map(|i| [0., -0., 0.00317, 0.7, 1e-10, 17.][i % 6])
+                .collect();
+            let original =
+                Int8Matrix::from_parts(rows, cols, weights.clone(), scales.clone()).unwrap();
+            let mut packed = Int8Matrix::from_parts(rows, cols, weights, scales).unwrap();
+            packed.prepare_dynamic();
+            assert_eq!(original.storage_bytes(), packed.storage_bytes());
+            let before = packed.dequantize().unwrap();
+            packed.prepare_dynamic();
+            assert_eq!(
+                before.data.iter().map(|v| v.to_bits()).collect::<Vec<_>>(),
+                packed
+                    .dequantize()
+                    .unwrap()
+                    .data
+                    .iter()
+                    .map(|v| v.to_bits())
+                    .collect::<Vec<_>>()
+            );
+            assert_eq!(
+                before.data.iter().map(|v| v.to_bits()).collect::<Vec<_>>(),
+                original
+                    .dequantize()
+                    .unwrap()
+                    .data
+                    .iter()
+                    .map(|v| v.to_bits())
+                    .collect::<Vec<_>>()
+            );
+            for backend in [Backend::Scalar, Backend::Auto] {
+                let mut cpu = CpuContext::new(backend, 4, 1 << 24).unwrap();
+                for batch in [1, 3] {
+                    let x = Tensor::new(
+                        vec![batch, cols],
+                        (0..batch * cols)
+                            .map(|i| ((i * 13 % 113) as f32 - 56.) / 37.)
+                            .collect(),
+                    )
+                    .unwrap();
+                    let a = original.linear(&x, &mut cpu).unwrap();
+                    let b = packed.linear(&x, &mut cpu).unwrap();
+                    assert_eq!(
+                        a.data.iter().map(|v| v.to_bits()).collect::<Vec<_>>(),
+                        b.data.iter().map(|v| v.to_bits()).collect::<Vec<_>>()
+                    );
+                    if batch == 1 {
+                        let a = original.linear_dynamic_int8(&x, &mut cpu).unwrap();
+                        let b = packed.linear_dynamic_int8(&x, &mut cpu).unwrap();
+                        assert_eq!(
+                            a.data.iter().map(|v| v.to_bits()).collect::<Vec<_>>(),
+                            b.data.iter().map(|v| v.to_bits()).collect::<Vec<_>>()
+                        );
+                    }
+                }
+            }
+        }
+    }
