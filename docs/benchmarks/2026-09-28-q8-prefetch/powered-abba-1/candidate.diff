+                    .collect();
+                let xs: Vec<f32> = (0..blocks).map(|i| (i % 17 + 1) as f32 / 123.).collect();
+                let a =
+                    unsafe { dot_int8_four_rows(&weights[offset..], &x[offset..], &scales, &xs) };
+                let b = unsafe {
+                    dot_int8_four_rows_prefetch(&weights[offset..], &x[offset..], &scales, &xs)
+                };
+                assert_eq!(a.map(f32::to_bits), b.map(f32::to_bits));
+            }
+        }
+    }
