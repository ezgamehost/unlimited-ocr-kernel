+                let blocks = cols / 32;
+                let mut weights = vec![0i8; offset];
+                weights.extend((0..4 * cols).map(|i| (i * 71 + i / 17) as i8));
+                let mut x = vec![0i8; offset];
+                x.extend((0..cols).map(|i| (i * 53 + i / 11) as i8));
+                let scales: Vec<f32> = (0..4 * blocks)
