{"result":{"finish_reason":"eos","image_tokens":1513,"precision":"int4_body_int8_head_dynamic_int8_activations","text":"<|det|>title [43, 36, 252, 59]<|/det|>文档识别测试报告\n<|det|>text [45, 83, 402, 105]<|/det|>日期：二零二六年九月二十七日\n<|det|>text [42, 130, 492, 152]<|/det|>本报告用于检查中文文档识别的正确性。\n<|det|>text [45, 154, 542, 175]<|/det|>每次测试都应保存原始图片和完整识别结果。\n<|det|>text [45, 178, 617, 199]<|/det|>性能指标包括处理时间、内存使用量和字符错误率。\n<|det|>text [45, 201, 567, 222]<|/det|>提高运行速度的同时，必须保持文字识别准确。\n<|det|>text [42, 248, 167, 269]<|/det|>测试要求：\n<|det|>text [43, 272, 441, 293]<|/det|>第一，检查标题和正文的阅读顺序。\n<|det|>text [45, 296, 491, 316]<|/det|>第二，检查数字、标点符号和表格内容。\n<|det|>text [45, 319, 465, 340]<|/det|>第三，不得忽略失败或未完成的测试。\n<|det|>text [45, 343, 441, 364]<|/det|>第四，在相同设备上比较相同输入。\n<|det|>text [43, 390, 251, 412]<|/det|>负责人：研究团队","timings":{"decode_seconds":1.8744594590000003,"decode_steps":289,"first_token_seconds":7.480632916,"prefill_seconds":1.582981167,"preprocess_seconds":0.1167845,"total_seconds":9.379319541,"vision_seconds":5.780786833},"token_ids":[128818,10212,764,3354,14,223,1872,14,223,14639,14,223,3318,63,128819,25728,19742,10251,7018,201,128818,2067,764,1883,14,223,6131,14,223,18572,14,223,6992,63,128819,14590,768,114322,1304,42986,53215,90082,1080,201,128818,2067,764,3180,14,223,7013,14,223,25880,14,223,10073,63,128819,917,7018,6441,5640,21134,25728,2144,16839,6775,946,876,128818,2067,764,1883,14,223,10761,14,223,26219,14,223,9700,63,128819,12718,10251,87021,16514,19443,14529,548,13380,19742,4498,876,128818,2067,764,1883,14,223,9827,14,223,25945,14,223,1357,63,128819,10861,10909,4250,4398,2130,410,26127,2541,54424,15019,10070,2295,876,128818,2067,764,1883,14,223,643,14,223,25601,14,223,12398,63,128819,4182,8738,6742,16142,303,4330,6710,10541,19742,12963,876,128818,2067,764,3180,14,223,16222,14,223,11185,14,223,17895,63,128819,10251,3099,7524,128818,2067,764,3354,14,223,16879,14,223,21873,14,223,17928,63,128819,2879,303,5640,24153,548,33292,301,8506,18143,876,128818,2067,764,1883,14,223,18743,14,223