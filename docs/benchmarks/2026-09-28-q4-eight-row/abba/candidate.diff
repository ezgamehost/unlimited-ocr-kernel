+/// Eight row-major outputs sharing activation loads, with ordered block sums.
+#[cfg(target_arch = "aarch64")]
+#[target_feature(enable = "dotprod")]
+pub(super) unsafe fn dot_int4_eight_rows(
+    weights: &[u8],
+    x: &[i8],
+    ws: &[f32],
+    xs: &[f32],
+) -> [f32; 8] {
+    use std::arch::aarch64::*;
+    assert!(x.len().is_multiple_of(32));
+    assert_eq!(weights.len().checked_div(4), Some(x.len()));
+    assert!(weights.len().is_multiple_of(4));
+    let blocks = x.len() / 32;
+    assert_eq!(xs.len(), blocks);
+    assert_eq!(ws.len(), blocks * 8);
+    let mut totals = [vdupq_n_f32(0.); 2];
+    for b in 0..blocks {
+        // SAFETY: caller proves dotprod support. Length assertions cover eight
+        // complete packed rows, activation blocks, and both scale arrays.
+        // Every signed integer block sum is bounded by 32*8*128 and fits i32.
+        unsafe {
+            let x0 = vld1q_s8(x.as_ptr().add(b * 32));
+            let x1 = vld1q_s8(x.as_ptr().add(b * 32 + 16));
+            let mut sums = [vdupq_n_s32(0); 8];
+            for (row, sum) in sums.iter_mut().enumerate() {
+                let w = vld1q_u8(weights.as_ptr().add(row * (x.len() / 2) + b * 16));
+                let low = vshrq_n_s8::<4>(vreinterpretq_s8_u8(vshlq_n_u8::<4>(w)));
+                let high = vshrq_n_s8::<4>(vreinterpretq_s8_u8(w));
+                *sum = vdotq_s32(vdotq_s32(*sum, low, x0), high, x1);
+            }
+            for (half, total) in totals.iter_mut().enumerate() {
+                let row = half * 4;
+                let sums = vpaddq_s32(
+                    vpaddq_s32(sums[row], sums[row + 1]),
+                    vpaddq_s32(sums[row + 2], sums[row + 3]),
+                );
+                let scales = [
+                    ws[row * blocks + b],
+                    ws[(row + 1) * blocks + b],
+                    ws[(row + 2) * blocks + b],
+                    ws[(row + 3) * blocks + b],
+                ];
+                let scaled = vmulq_n_f32(
+                    vmulq_f32(vcvtq_f32_s32(sums), vld1q_f32(scales.as_ptr())),
+                    xs[b],
+                );
+                *total = vaddq_f32(*total, scaled);
+            }
+        }
+    }
+    let mut result = [0.; 8];
+    // SAFETY: two disjoint complete four-float regions in result.
+    unsafe {
+        vst1q_f32(result.as_mut_ptr(), totals[0]);
+        vst1q_f32(result.as_mut_ptr().add(4), totals[1]);
+    }
+    result
+}
