+    /// Divide existing worker capacity equally among concurrent projection tasks.
+    /// As with serial_worker, the caller reserves aggregate scratch and passes
+    /// a nonzero task count. The shared pool bounds actual worker creation.
+    pub(crate) fn balanced_worker(&self, concurrent_tasks: usize) -> Self {
+        let mut worker = self.serial_worker(concurrent_tasks);
+        worker.threads = (self.threads / concurrent_tasks).max(1);
+        worker
+    }
