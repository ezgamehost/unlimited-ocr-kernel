+/// Erf GELU using A&S 7.1.26 and bounded vector exponential scratch.
+/// The mathematical erf approximation has absolute error <= 1.5e-7;
+/// FP32 rounding adds error, covered separately by numerical/reference tests.
+/// Source: https://personal.math.ubc.ca/~cbm/aands/page_299.htm
+pub fn gelu_backend(values: &mut [f32], backend: Backend) {
+    #[cfg(target_os = "macos")]
+    if backend != Backend::Scalar {
+        let mut scratch = [0f32; 1024];
+        for chunk in values.chunks_mut(scratch.len()) {
+            let exp = &mut scratch[..chunk.len()];
+            for (dest, &x) in exp.iter_mut().zip(chunk.iter()) {
+                let u = x * std::f32::consts::FRAC_1_SQRT_2;
+                *dest = -u * u;
+            }
+            accelerate::exp_in_place(exp);
+            for (x, &exp) in chunk.iter_mut().zip(exp.iter()) {
+                let u = *x * std::f32::consts::FRAC_1_SQRT_2;
+                let t = 1. / (1. + 0.3275911 * u.abs());
+                let polynomial = (((((1.0614054 * t - 1.4531521) * t) + 1.4214138) * t
+                    - 0.28449672) * t + 0.2548296) * t;
+                let erf = (1. - polynomial * exp).copysign(u);
+                *x *= 0.5 * (1. + erf);
+            }
+        }
+        return;
+    }
+    #[cfg(not(target_os = "macos"))]
+    let _ = backend;
+    gelu(values);
+}
+
 pub fn quick_gelu(values: &mut [f32]) {
     for value in values {
         *value /= 1. + (-1.702 * *value).exp();
     }
 }
 
+/// Same QuickGELU formula with bounded vector exponential scratch on macOS.
+pub fn quick_gelu_backend(values: &mut [f32], backend: Backend) {
+    #[cfg(target_os = "macos")]
+    if backend != Backend::Scalar {
+        let mut scratch = [0f32; 1024];
+        for chunk in values.chunks_mut(scratch.len()) {
+            let exp = &mut scratch[..chunk.len()];
+            for (dest, &x) in exp.iter_mut().zip(chunk.iter()) {
+                *dest = -1.702 * x;
+            }
+            accelerate::exp_in_place(exp);
+            for (x, &exp) in chunk.iter_mut().zip(exp.iter()) {
+                *x /= 1. + exp;
+            }
+        }
+        return;
+    }
+    #[cfg(not(target_os = "macos"))]
+    let _ = backend;
+    quick_gelu(values);
+}
