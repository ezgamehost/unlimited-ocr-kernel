+/// Four rows stored as consecutive 32-byte blocks with interleaved scales.
+#[cfg(target_arch = "aarch64")]
+#[target_feature(enable = "dotprod")]
+pub(super) unsafe fn dot_int8_packed_four(
+    weights: &[i8],
+    x: &[i8],
+    scales: &[f32],
+    xs: &[f32],
+) -> [f32; 4] {
+    use std::arch::aarch64::*;
+    assert!(x.len().is_multiple_of(32));
+    assert_eq!(weights.len().checked_div(4), Some(x.len()));
+    assert!(weights.len().is_multiple_of(4));
+    assert_eq!(xs.len(), x.len() / 32);
+    assert_eq!(scales.len(), xs.len() * 4);
+    let mut total = vdupq_n_f32(0.);
+    for (b, &scale) in xs.iter().enumerate() {
+        // SAFETY: caller checks dotprod. The validated packed block holds
+        // four complete rows of 32 bytes and four contiguous scales.
+        unsafe {
+            let x0 = vld1q_s8(x.as_ptr().add(b * 32));
+            let x1 = vld1q_s8(x.as_ptr().add(b * 32 + 16));
+            let mut sums = [vdupq_n_s32(0); 4];
+            for (row, sum) in sums.iter_mut().enumerate() {
+                let w = weights.as_ptr().add(b * 128 + row * 32);
+                *sum = vdotq_s32(vdotq_s32(*sum, vld1q_s8(w), x0), vld1q_s8(w.add(16)), x1);
+            }
+            let sums = vpaddq_s32(vpaddq_s32(sums[0], sums[1]), vpaddq_s32(sums[2], sums[3]));
+            let scaled = vmulq_n_f32(
+                vmulq_f32(vcvtq_f32_s32(sums), vld1q_f32(scales.as_ptr().add(b * 4))),
+                scale,
+            );
+            total = vaddq_f32(total, scaled);
+        }
+    }
+    let mut result = [0.; 4];
+    // SAFETY: four writable output floats.
+    unsafe {
+        vst1q_f32(result.as_mut_ptr(), total);
+    }
+    result
+}
