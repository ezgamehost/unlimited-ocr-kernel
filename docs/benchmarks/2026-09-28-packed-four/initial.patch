+        for cols in [32usize, 64, 896, 1280, 1792, 6848] {
+            let blocks = cols / 32;
+            let w: Vec<i8> = (0..cols * 8)
+                .map(|i| ((i * 53 % 256) as i16 - 128) as i8)
+                .collect();
+            let x: Vec<i8> = (0..cols)
+                .map(|i| ((i * 71 % 256) as i16 - 128) as i8)
+                .collect();
+            let ws: Vec<f32> = (0..blocks * 8)
+                .map(|i| [0., 0.00317, 0.7, 1e-10, 17.][i % 5])
+                .collect();
+            let xs: Vec<f32> = (0..blocks).map(|i| (i % 17 + 1) as f32 / 123.).collect();
+            let (pw, ps) = pack_four(&w, &ws, cols);
+            let mut unaligned = vec![0i8];
+            unaligned.extend_from_slice(&pw);
+            for group in 0..2 {
+                // SAFETY: detected ISA, complete rows and matching scale counts.
+                let actual = unsafe {
+                    dot_int8_packed_four(
+                        &unaligned[1 + group * 4 * cols..1 + (group + 1) * 4 * cols],
+                        &x,
+                        &ps[group * 4 * blocks..(group + 1) * 4 * blocks],
+                        &xs,
+                    )
+                };
+                for (r, actual) in actual.iter().enumerate() {
+                    let row = group * 4 + r;
+                    let mut expected = 0f32;
+                    for b in 0..blocks {
+                        let sum: i32 = (0..32)
+                            .map(|j| w[row * cols + b * 32 + j] as i32 * x[b * 32 + j] as i32)
+                            .sum();
+                        expected += sum as f32 * ws[row * blocks + b] * xs[b];
+                    }
+                    assert_eq!(
+                        actual.to_bits(),
+                        expected.to_bits(),
+                        "cols={cols} row={row}"
+                    );
+                }
+            }
+        }
+    }
