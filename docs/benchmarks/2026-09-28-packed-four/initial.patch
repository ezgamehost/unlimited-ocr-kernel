+fn packed_storage_preserves_dequantization_prefill_and_dynamic_decode() {
+    for (rows, cols) in [(8, 32), (132, 1280), (12, 896), (9, 33), (7, 64)] {
+        let original = Tensor::new(
+            vec![rows, cols],
+            (0..rows * cols).map(|i| (i as f32 * 0.37).sin()).collect(),
+        )
+        .unwrap();
+        let reference = Int8Matrix::quantize(&original).unwrap();
+        let mut packed = Int8Matrix::quantize(&original).unwrap();
+        let bytes = packed.storage_bytes();
+        packed.pack_for_decode();
+        packed.pack_for_decode(); // Idempotence must not scramble the layout.
+        assert_eq!(packed.storage_bytes(), bytes);
+        assert_eq!(
+            packed.dequantize().unwrap().data,
+            reference.dequantize().unwrap().data
+        );
+        for backend in [Backend::Scalar, Backend::Auto] {
+            let mut cpu = CpuContext::new(backend, 3, 1 << 24).unwrap();
+            let x = Tensor::new(
+                vec![1, cols],
+                (0..cols).map(|i| (i as f32 * 0.17).cos()).collect(),
+            )
+            .unwrap();
+            assert_eq!(
+                packed.linear_dynamic_int8(&x, &mut cpu).unwrap().data,
+                reference.linear_dynamic_int8(&x, &mut cpu).unwrap().data
+            );
+            let x = Tensor::new(
