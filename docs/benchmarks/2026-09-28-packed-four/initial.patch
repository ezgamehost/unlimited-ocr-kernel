+    fn pack_four(weights: &[i8], scales: &[f32], cols: usize) -> (Vec<i8>, Vec<f32>) {
+        let blocks = cols / 32;
+        let mut packed = Vec::with_capacity(weights.len());
+        let mut packed_scales = Vec::with_capacity(scales.len());
+        for group in 0..weights.len() / (4 * cols) {
+            for block in 0..blocks {
+                for row in 0..4 {
+                    let offset = (group * 4 + row) * cols + block * 32;
+                    packed.extend_from_slice(&weights[offset..offset + 32]);
+                    packed_scales.push(scales[(group * 4 + row) * blocks + block]);
+                }
+            }
+        }
+        (packed, packed_scales)
+    }
