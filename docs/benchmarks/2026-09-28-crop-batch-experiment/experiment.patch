+    /// Encode local 640px crops in bounded SAM batches, preserving input order.
+    pub fn encode_crops(&self, crops: &[Tensor], cpu: &mut CpuContext) -> Result<Vec<Tensor>> {
+        for crop in crops {
+            crop.validate()?;
+            if crop.shape != [1, 640, 640, 3] {
+                return Err(OcrError::Shape("local crop must be 640x640 RGB".into()));
+            }
+        }
+        let mut output = Vec::with_capacity(crops.len());
+        for batch in crops.chunks(3) {
+            let count = batch.len() * 640 * 640 * 3;
+            cpu.check_elements(count)?;
+            let mut data = Vec::with_capacity(count);
+            for crop in batch {
+                data.extend_from_slice(&crop.data);
+            }
+            let sam = self.sam(&Tensor::new(vec![batch.len(), 640, 640, 3], data)?, cpu)?;
+            if sam.shape != [batch.len(), 10, 10, 1024] {
+                return Err(OcrError::Shape("batched SAM output".into()));
+            }
+            for features in sam.data.chunks_exact(100 * 1024) {
+                let crop = Tensor::new(vec![1, 10, 10, 1024], features.to_vec())?;
+                let clip = self.clip(&crop, cpu)?;
+                output.push(self.project(&crop, &clip, cpu)?);
+            }
+        }
+        Ok(output)
+    }
+
