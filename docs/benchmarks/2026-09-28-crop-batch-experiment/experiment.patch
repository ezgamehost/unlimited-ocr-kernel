--- /dev/null
+++ b/examples/bench_crops.rs
@@ -0,0 +1,35 @@
+use std::{hint::black_box, path::Path, time::Instant};
+use uocr::{
+    checkpoint::Checkpoint,
+    cpu::{Backend, CpuContext},
+    preprocess::{ImageMode, prepare},
+    vision::Vision,
+};
+fn main() {
+    let weights = Checkpoint::open(Path::new(
+        "artifacts/upstream/model-00001-of-000001.safetensors",
+    ))
+    .unwrap();
+    let model = Vision::new(&weights).unwrap();
+    let input = prepare(
+        Path::new("benchmarks/corpus/english.png"),
+        ImageMode::Gundam,
+    )
+    .unwrap();
+    let mut cpu = CpuContext::new(Backend::Auto, 8, 1 << 30).unwrap();
+    for batch in [false, true, true, false] {
+        let start = Instant::now();
+        if batch {
+            black_box(model.encode_crops(&input.crops, &mut cpu).unwrap());
+        } else {
+            for crop in &input.crops {
+                black_box(model.encode_view_debug(crop, &mut cpu).unwrap());
+            }
+        }
+        println!(
+            "batch={batch} crops={} seconds={:.6}",
+            input.crops.len(),
+            start.elapsed().as_secs_f64()
+        );
+    }
+}
