+
+#[test]
+#[ignore = "requires original model and English crop reference"]
+fn crop_batches_preserve_order_and_handle_partial_last_batch() {
+    let image = uocr::preprocess::prepare(
+        Path::new("benchmarks/corpus/english.png"),
+        uocr::preprocess::ImageMode::Gundam,
+    )
+    .unwrap();
+    let weights = Checkpoint::open(Path::new(
+        "artifacts/upstream/model-00001-of-000001.safetensors",
+    ))
+    .unwrap();
+    let model = Vision::new(&weights).unwrap();
+    let reference = Checkpoint::open(Path::new(
+        "artifacts/reference-english-gundam-f32/vision.safetensors",
+    ))
+    .unwrap();
+    let mut cpu = CpuContext::new(Backend::Auto, 8, 1 << 30).unwrap();
+    let actual = model.encode_crops(&image.crops[..4], &mut cpu).unwrap();
+    assert_eq!(actual.len(), 4);
+    for (i, value) in actual.iter().enumerate() {
+        compare(
+            &format!("batch crop {i}"),
+            &value.data,
+            &reference
+                .tensor(&format!("crop.{i}.projected"))
+                .unwrap()
+                .to_f32(),
+        );
+    }
+    assert!(model.encode_crops(&[], &mut cpu).unwrap().is_empty());
+    assert!(model.encode_crops(&[image.global], &mut cpu).is_err());
+}
