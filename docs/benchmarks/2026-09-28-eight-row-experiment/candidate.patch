+    #[test]
+    fn eight_rows_preserve_block_order_and_unaligned_integer_extremes() {
+        if !std::arch::is_aarch64_feature_detected!("dotprod") {
+            return;
+        }
+        // Catch row/scale strides, missing second groups, rounding-order changes,
+        // and alignment assumptions with an independent scalar block oracle.
+        for cols in [32usize, 64, 896, 1280, 1792, 6848] {
+            let blocks = cols / 32;
+            let weights: Vec<i8> = (0..cols * 8 + 1)
+                .map(|i| ((i * 53 % 256) as i16 - 128) as i8)
+                .collect();
+            let input: Vec<i8> = (0..cols + 1)
+                .map(|i| ((i * 71 % 256) as i16 - 128) as i8)
+                .collect();
+            let scales: Vec<f32> = (0..blocks * 8 + 1)
+                .map(|i| [0., 0.00317, 0.7, 1e-10, 17.][i % 5])
+                .collect();
+            let xs: Vec<f32> = (0..blocks).map(|i| (i % 17 + 1) as f32 / 123.).collect();
+            let (weights, input, scales) = (&weights[1..], &input[1..], &scales[1..]);
+            // SAFETY: runtime ISA check and complete exact-size row storage.
+            let actual = unsafe { dot_int8_eight_rows(weights, input, scales, &xs) };
+            for row in 0..8 {
+                let mut expected = 0f32;
+                for b in 0..blocks {
+                    let sum: i32 = (0..32)
+                        .map(|j| weights[row * cols + b * 32 + j] as i32 * input[b * 32 + j] as i32)
+                        .sum();
+                    expected += sum as f32 * scales[row * blocks + b] * xs[b];
+                }
+                assert_eq!(
+                    actual[row].to_bits(),
+                    expected.to_bits(),
+                    "cols={cols} row={row}"
+                );
