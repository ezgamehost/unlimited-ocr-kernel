+    #[target_feature(enable = "dotprod")]
+    unsafe fn dot_int8_eight_rows(weights: &[i8], x: &[i8], ws: &[f32], xs: &[f32]) -> [f32; 8] {
+        use std::arch::aarch64::*;
+        assert!(x.len().is_multiple_of(32));
+        assert_eq!(weights.len().checked_div(8), Some(x.len()));
+        assert!(weights.len().is_multiple_of(8));
+        let blocks = x.len() / 32;
+        assert_eq!(xs.len(), blocks);
+        assert_eq!(ws.len(), blocks * 8);
+        let mut low = vdupq_n_f32(0.);
+        let mut high = low;
+        for b in 0..blocks {
+            // SAFETY: caller checks dotprod. All eight row loads stay within
+            // complete 32-byte blocks; block sums fit signed i32.
+            unsafe {
+                let x0 = vld1q_s8(x.as_ptr().add(b * 32));
+                let x1 = vld1q_s8(x.as_ptr().add(b * 32 + 16));
+                let mut sums = [vdupq_n_s32(0); 8];
+                for (row, sum) in sums.iter_mut().enumerate() {
+                    let w = weights.as_ptr().add(row * x.len() + b * 32);
+                    *sum = vdotq_s32(vdotq_s32(*sum, vld1q_s8(w), x0), vld1q_s8(w.add(16)), x1);
+                }
+                let a = vpaddq_s32(vpaddq_s32(sums[0], sums[1]), vpaddq_s32(sums[2], sums[3]));
+                let c = vpaddq_s32(vpaddq_s32(sums[4], sums[5]), vpaddq_s32(sums[6], sums[7]));
+                let scales0 = [
+                    ws[b],
+                    ws[blocks + b],
+                    ws[2 * blocks + b],
+                    ws[3 * blocks + b],
+                ];
+                let scales1 = [
+                    ws[4 * blocks + b],
+                    ws[5 * blocks + b],
+                    ws[6 * blocks + b],
+                    ws[7 * blocks + b],
+                ];
+                low = vaddq_f32(
+                    low,
+                    vmulq_n_f32(
+                        vmulq_f32(vcvtq_f32_s32(a), vld1q_f32(scales0.as_ptr())),
+                        xs[b],
+                    ),
+                );
+                high = vaddq_f32(
+                    high,
+                    vmulq_n_f32(
+                        vmulq_f32(vcvtq_f32_s32(c), vld1q_f32(scales1.as_ptr())),
+                        xs[b],
+                    ),
+                );
+            }
+        }
+        let mut output = [0.; 8];
+        // SAFETY: output has eight writable floats, split into two four-lane stores.
+        unsafe {
+            vst1q_f32(output.as_mut_ptr(), low);
+            vst1q_f32(output.as_mut_ptr().add(4), high);
+        }
+        output
+    }
